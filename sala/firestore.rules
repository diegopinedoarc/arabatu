rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Ayudas para la sala de estudio ----------
    function salaPerfil() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function salaAprobado() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && salaPerfil().approved == true;
    }
    function salaAdmin() {
      return salaAprobado()
        && (salaPerfil().get('admin', false) == true || salaPerfil().get('rol', '') == 'admin');
    }

    function salaSuper() {
      return salaAprobado() && salaPerfil().get('superadmin', false) == true;
    }

    // Usuarios — cada uno lee el suyo y puede crear SU perfil al registrarse,
    // siempre pendiente y sin permisos. Solo el superadmin (campo superadmin: true,
    // que se pone a mano en la consola de Firebase) ve a todos y cambia aprobado/admin/tesorero.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || salaSuper());
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.approved == false
        && !('admin' in request.resource.data)
        && !('rol' in request.resource.data)
        && !('superadmin' in request.resource.data);
      allow update: if salaSuper() && request.auth.uid != userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved', 'admin', 'rol']);
    }

    // Control Caja — solo tesoreros
    match /caja_integrantes/{doc} {
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'tesorero';
    }
    match /caja_movimientos/{doc} {
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'tesorero';
    }
    match /caja_config/{doc} {
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'tesorero';
    }

    // Favoritos de la sala — cada miembro aprobado lee y escribe solo los suyos
    match /users/{userId}/favoritos/{materialId} {
      allow read, write: if salaAprobado() && request.auth.uid == userId;
    }

    // Sala de estudio — leen los aprobados, escribe solo el admin
    match /guiones/{id} {
      allow read: if salaAprobado();
      allow write: if salaAdmin();
    }
    match /materiales/{id} {
      allow read: if salaAprobado();
      allow write: if salaAdmin();
    }

  }
}
